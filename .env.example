APP_NAME="Dashboard Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dashboard_monitor
DB_USERNAME=dashboard
DB_PASSWORD=dashboard_local
FORWARD_DB_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ZABBIX_URL=
ZABBIX_TOKEN=
ZBX_KRIAN_CCTV=28,29,30,31,32,33,34,35,36
ZBX_SIDOARJO_CCTV=
ZBX_SURABAYA_CCTV=
ZBX_KRIAN_AP=23
ZBX_SIDOARJO_AP=
ZBX_SURABAYA_AP=
ZBX_KRIAN_COMPUTERS=25
ZBX_SIDOARJO_COMPUTERS=
ZBX_SURABAYA_COMPUTERS=
ZABBIX_COMPUTER_CPU_WARNING=85
ZABBIX_COMPUTER_MEMORY_WARNING=90
ZABBIX_COMPUTER_DISK_WARNING=85
ZBX_KRIAN_NAS=27
ZBX_SIDOARJO_NAS=
ZBX_SURABAYA_NAS=
ZABBIX_NAS_STORAGE_WARNING=85
ZABBIX_NAS_CPU_WARNING=85
ZABBIX_NAS_TEMPERATURE_WARNING=60
ZABBIX_NAS_DISK_TEMPERATURE_WARNING=55
